{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/local/kita-lugano/data/kitas.schema.json",
  "title": "KiTa Lugano dataset",
  "description": "Structured directory of day-care centres (asili nido / kita) for pre-school children in Lugano and its agglomeration.",
  "type": "object",
  "required": ["meta", "kitas"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "kitas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kita" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "schema_version", "data_version", "disclaimer", "sources", "count"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "data_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "currency": { "type": "string", "enum": ["CHF", "EUR"] },
        "disclaimer": { "type": "string", "minLength": 10 },
        "count": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "label", "url", "publisher", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "publisher": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "kita": {
      "type": "object",
      "required": [
        "id", "name", "type", "comune", "in_city_of_lugano", "address",
        "geo", "contact", "capacity", "age", "hours", "languages", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 2 },
        "type": { "type": "string", "enum": ["pubblico", "privato"] },
        "operator": { "type": ["string", "null"] },
        "comune": { "type": "string", "minLength": 2 },
        "zona": { "type": ["string", "null"] },
        "in_city_of_lugano": { "type": "boolean" },
        "address": { "$ref": "#/$defs/address" },
        "geo": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/geo" }] },
        "contact": { "$ref": "#/$defs/contact" },
        "capacity": { "type": ["integer", "null"], "minimum": 1, "maximum": 500 },
        "age": { "$ref": "#/$defs/age" },
        "hours": { "$ref": "#/$defs/hours" },
        "closures": { "type": ["string", "null"] },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["it", "en", "de", "fr"] }
        },
        "notes": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "address": {
      "type": "object",
      "required": ["street", "postal_code", "locality", "full"],
      "additionalProperties": false,
      "properties": {
        "street": { "type": ["string", "null"] },
        "postal_code": { "type": "string", "pattern": "^\\d{4}$" },
        "locality": { "type": "string", "minLength": 2 },
        "full": { "type": "string", "minLength": 4 }
      }
    },
    "geo": {
      "type": "object",
      "required": ["lat", "lon", "precision", "geocoder"],
      "additionalProperties": true,
      "properties": {
        "lat": { "type": "number", "minimum": 45.7, "maximum": 46.2 },
        "lon": { "type": "number", "minimum": 8.7, "maximum": 9.2 },
        "precision": { "type": "string", "enum": ["address", "street", "locality"] },
        "accuracy": { "type": "string" },
        "geocoder": { "type": "string", "minLength": 3 }
      }
    },
    "contact": {
      "type": "object",
      "required": ["phone", "email", "website"],
      "additionalProperties": true,
      "properties": {
        "phone": { "type": ["string", "null"], "pattern": "^\\+41 [0-9 ]+$" },
        "phone_alt": { "type": ["string", "null"], "pattern": "^\\+41 [0-9 ]+$" },
        "email": { "type": ["string", "null"], "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$" },
        "website": { "type": ["string", "null"], "pattern": "^https?://" }
      }
    },
    "age": {
      "type": "object",
      "required": ["min_months", "max_months", "label"],
      "additionalProperties": false,
      "properties": {
        "min_months": { "type": "integer", "minimum": 0, "maximum": 84 },
        "max_months": { "type": "integer", "minimum": 1, "maximum": 96 },
        "label": { "type": "string", "minLength": 2 }
      }
    },
    "hours": {
      "type": "object",
      "required": ["label", "open", "close", "days", "continuous"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "open": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "close": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["mo", "tu", "we", "th", "fr", "sa", "su"] }
        },
        "continuous": { "type": "boolean" }
      }
    }
  }
}
